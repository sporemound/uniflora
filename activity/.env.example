# Keep the Discord Activity bridge disabled on the standalone domain.
VITE_ENABLE_DISCORD_SDK=false

# Full website mode. The tracked .env.preview selects the separate static preview.
VITE_PREVIEW_ONLY=false

# The domain opens the live campaign by default.
VITE_DEFAULT_ENVIRONMENT=live

VITE_ENABLE_LIVE_ENVIRONMENT=true

# Match HYPHA_LIVE_CHAT_ENABLED only after the Python relay is running.
VITE_ENABLE_LIVE_CHAT=false
