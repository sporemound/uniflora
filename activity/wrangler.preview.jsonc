{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uniflora-preview",
  "main": "./worker/preview.ts",
  "compatibility_date": "2026-07-25",
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "DEMO_IP_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 2, "period": 60 }
    },
    {
      "name": "DEMO_GLOBAL_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "PUBLIC_DB",
      "database_name": "uniflora-preview-public",
      "migrations_dir": "preview-migrations",
      "database_id": "00000000-0000-0000-0000-000000000003"
    },
    {
      "binding": "CHAT_DB",
      "database_name": "uniflora-preview-chat",
      "migrations_dir": "chat-migrations",
      "database_id": "00000000-0000-0000-0000-000000000004"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://uniflora.example.invalid",
    "DEMO_CHAT_ENABLED": "true",
    "SESSION_TTL_SECONDS": "43200"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
