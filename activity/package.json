{
  "name": "missing-interior-web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/scrub_build_secrets.mjs",
    "build:preview": "tsc --noEmit && vite build --mode preview && node tools/scrub_build_secrets.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && npm run validate:activity-links && npm run validate:external-layers && npm run validate:dynamical-render && wrangler deploy",
    "deploy:preview": "npm run build:preview && npm run validate:activity-links && npm run validate:external-layers && npm run validate:dynamical-render && npm run validate:preview-chat && npm run validate:guest-demo && npm run validate:live-public-record && npm run validate:preview-migrations && wrangler deploy --config wrangler.preview.jsonc",
    "check": "npm run build",
    "db:migrate:local": "wrangler d1 migrations apply PUBLIC_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply PUBLIC_DB --remote",
    "db:list": "wrangler d1 migrations list PUBLIC_DB --local",
    "db:migrate:chat:local": "wrangler d1 migrations apply CHAT_DB --local",
    "db:migrate:chat:remote": "wrangler d1 migrations apply CHAT_DB --remote",
    "db:list:chat": "wrangler d1 migrations list CHAT_DB --remote",
    "db:list:preview:public:remote": "wrangler d1 migrations list PUBLIC_DB --remote --config wrangler.preview.jsonc",
    "db:list:preview:chat:remote": "wrangler d1 migrations list CHAT_DB --remote --config wrangler.preview.jsonc",
    "db:migrate:preview:public:remote": "wrangler d1 migrations apply PUBLIC_DB --remote --config wrangler.preview.jsonc",
    "db:migrate:preview:chat:remote": "wrangler d1 migrations apply CHAT_DB --remote --config wrangler.preview.jsonc",
    "validate:phase4": "node tools/validate_phase4.mjs",
    "validate:phase4b": "node tools/validate_phase4b.mjs",
    "validate:phase4c": "node tools/validate_phase4c.mjs",
    "validate:position-access": "node tools/validate_position_access.mjs",
    "validate:activity-links": "node tools/validate_activity_links.mjs",
    "validate:dynamical-render": "node tools/validate_dynamical_render_endpoint.mjs",
    "validate:external-layers": "node tools/validate_external_layers.mjs",
    "validate:facility-science": "node tools/validate_facility_science.mjs",
    "validate:facility-science-runtime": "node tools/validate_facility_science_runtime.mjs",
    "validate:optional-audio": "node tools/validate_optional_audio.mjs",
    "validate:science-sonification": "node tools/validate_science_sonification.mjs",
    "validate:ufosint-sidequests": "node tools/validate_ufosint_sidequests.mjs",
    "validate:hypha-chat": "npm run build && node tools/validate_hypha_chat.mjs",
    "validate:guest-demo": "node tools/validate_guest_demo.mjs",
    "validate:preview-chat": "node tools/validate_preview_chat.mjs",
    "validate:live-public-record": "node tools/validate_live_public_record.mjs",
    "validate:preview-migrations": "node tools/validate_preview_migrations.mjs",
    "data:public-reports": "node tools/import_uapdrop_reports.mjs"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "2.5.0",
    "maplibre-gl": "5.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
