# Discord bot credentials and exact test/live routing.
# Copy this file to .env locally, but never commit the populated .env.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
LIVE_PUZZLE_CHANNEL_ID=
TEST_PUZZLE_CHANNEL_ID=
MYCOTROPH_ROLE_ID=
ADMIN_USER_IDS=
DIAGNOSTIC_CHANNEL_ID=

# Runtime and persistent storage.
HEALTH_HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/interior.db
RUN_MIGRATIONS_ON_STARTUP=true
BACKUP_ENABLED=true
BACKUP_DIRECTORY=./backups
BACKUP_INTERVAL_HOURS=24
TEST_SURFACE_MARKER_ENABLED=true

# Authoritative v2 is exposed only through administrator-only test commands.
V2_TEST_ENABLED=true
V2_TEST_DATABASE_PATH=./data/v2-test-events.sqlite3
V2_TEST_STREAM_ID=discord-test
V2_LIVE_ENABLED=false
V2_LIVE_DATABASE_PATH=./data/v2-live-events.sqlite3
V2_LIVE_STREAM_ID=discord-live

# Optional signed read-only projection to the deployed Activity Worker.
V2_ACTIVITY_SYNC_ENABLED=false
V2_ACTIVITY_BASE_URL=
HYPHA_ACTIVITY_SECRET=
V2_BULLETIN_CHANNEL_ID=

# Optional local Hypha narration. Text remains complete and all progress
# remains available when this is false or the native tools are unavailable.
HYPHA_VOICE_ENABLED=true
# Facility openings/endings in the circulation desk may include narration.
HYPHA_VOICE_BULLETINS_ENABLED=true
# Keep routine command replies text-only unless explicitly opted in.
HYPHA_VOICE_REPLY_ATTACHMENTS_ENABLED=false
# Leave commands blank to discover packaged tools first, then PATH.
HYPHA_VOICE_ESPEAK_COMMAND=
HYPHA_VOICE_ESPEAK_DATA_ROOT=
HYPHA_VOICE_FFMPEG_COMMAND=
HYPHA_VOICE_MAX_CHARACTERS=6000
HYPHA_VOICE_PROCESS_TIMEOUT_SECONDS=45
HYPHA_VOICE_QUEUE_TIMEOUT_SECONDS=3
HYPHA_VOICE_MAX_CONCURRENT_REQUESTS=1
HYPHA_VOICE_MAX_PENDING_REQUESTS=2
HYPHA_VOICE_CACHE_ENABLED=true
HYPHA_VOICE_CACHE_MAX_ENTRIES=32

# Exterior scientific feed used by the existing station register.
# Keep disabled for the strict-$0 v2 test path; enabling it requires all credentials below.
UNIFLORA_APRSFI_ENABLED=false
UNIFLORA_APRSFI_API_KEY=
UNIFLORA_APRSFI_ALIAS_SECRET=
UNIFLORA_APRSFI_PROJECT_URL=https://example.invalid/missing-interior

# Deterministic gameplay defaults.
PLAYER_ACTION_COOLDOWN_SECONDS=0
FEATURE_NATURAL_LANGUAGE=false
FEATURE_GPT_NARRATION=false
FEATURE_TACTICAL_STACK=true
FEATURE_TRIGGERED_REACTIONS=true
FEATURE_PROPOSAL_KICKERS=true
FEATURE_SETTLEMENT_EVENTS=true
SETTLEMENT_EVENT_RESPONSE_MINUTES=120
SETTLEMENT_EVENT_POLL_SECONDS=60

# Optional OpenAI path. Explicit slash commands and v2 do not require it.
OPENAI_ENABLED=false
OPENAI_DRY_RUN=false
OPENAI_PRIVACY_ACKNOWLEDGED=false
OPENAI_API_KEY=

# Optional Gemini in-world dialogue. Disabled by default and non-authoritative:
# the deterministic v2 engine remains the only writer of game state.
FEATURE_GEMINI_CHAT=false
# Activity chat works without Discord Message Content Intent. Enable native
# Discord mention/reply chat separately only after granting that privileged intent.
FEATURE_GEMINI_DISCORD_CHAT=false
GEMINI_ENABLED=false
GEMINI_DRY_RUN=false
GEMINI_PRIVACY_ACKNOWLEDGED=false
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=12
GEMINI_MAX_OUTPUT_TOKENS=500
GEMINI_TEMPERATURE=0.65
