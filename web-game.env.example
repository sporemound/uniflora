# Reference for the standalone Python web game service. This file is not auto-loaded.
# Set values in the process environment or your hosting provider's secret store.

GAME_API_SECRET=
GAME_DB_PATH=./data/web-live-events.sqlite3
GAME_STREAM_ID=web-live
GAME_API_HOST=127.0.0.1
PORT=8080

# Match the Cloudflare site and Worker secret when publishing public game state.
V2_ACTIVITY_BASE_URL=http://127.0.0.1:5173
HYPHA_ACTIVITY_SECRET=

# Optional shared Hypha conversation. Leave disabled until its relay is configured.
WEB_HYPHA_CHAT_ENABLED=false
GEMINI_DRY_RUN=true
GEMINI_API_KEY=
GEMINI_PRIVACY_ACKNOWLEDGED=false
# Enable the signed /internal/voice/synthesize endpoint once the Worker can
# reach this Python service. The Docker image installs eSpeak NG and FFmpeg;
# HYPHA_ESPEAK_COMMAND and HYPHA_FFMPEG_COMMAND may override their PATH names.
HYPHA_VOICE_ENABLED=false
HYPHA_ESPEAK_COMMAND=
HYPHA_FFMPEG_COMMAND=
